# LUXA FURNITURE Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real credentials.
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── MongoDB ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────
# Use long, random strings (e.g. openssl rand -base64 64)
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase Storage ───────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=products

# ── Email (SMTP / Nodemailer) ──────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@luxafurniture.co.uk
MAIL_PASS=your-email-password
MAIL_FROM="LUXA FURNITURE <no-reply@luxafurniture.co.uk>"

# ── Frontend origin & on-demand ISR revalidation ───────────────────
# Used for CORS and notifying Next.js on-demand revalidation endpoint
FRONTEND_URL=http://localhost:3001

# Shared secret for on-demand ISR revalidation (must match frontend REVALIDATE_SECRET)
# Generated using a strong random key (e.g. openssl rand -hex 32)
REVALIDATE_SECRET=your-secure-revalidation-secret-at-least-32-chars

# ── Currency & VAT Settings (UK Market) ────────────────────────────
CURRENCY=GBP
VAT_RATE=0.20

# ── AI Listing Agent & Queue ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (used by the AI Listing Agent for UK catalogue generation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model to use for listing agent (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# UK Market & Pricing Configuration
CURRENCY=GBP
VAT_RATE=0.20
