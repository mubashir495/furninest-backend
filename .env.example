# LUXA FURNITURE Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real credentials.
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── MongoDB ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────
# Use long, random strings (e.g. openssl rand -base64 64)
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase Storage ───────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=products

# ── Email (SMTP / Nodemailer) ──────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@luxafurniture.co.uk
MAIL_PASS=your-email-password
MAIL_FROM="LUXA FURNITURE <no-reply@luxafurniture.co.uk>"

# ── Frontend origin (used in CORS allowlist) ───────────────────────
FRONTEND_URL=https://luxafurniture.vercel.app
